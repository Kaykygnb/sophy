{
  "name": "sophy",
  "version": "0.1.0",
  "private": true,
  "description": "Sophy — bibliotecas locais, notas e ideias conectadas",
  "main": "src/main.js",
  "author": "Sophy",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "mcp": "node src/mcp.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:engine": "node --experimental-strip-types --test engine/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.js *.json README.md",
    "format:check": "prettier --check src scripts tests *.js *.json README.md",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "marked": "18.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "productName": "Sophy",
  "build": {
    "appId": "app.sophy.desktop",
    "productName": "Sophy",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/*.figcraft",
      "!assets/Sophy-*.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/sophy.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/sophy.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/sophy.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sophy"
    }
  }
}
